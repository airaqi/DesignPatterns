@startuml

skinparam linetype ortho
'left to right direction

title Facade Pattern Example Strucure

class Compiler <<Facade>>

together {
    together {
        together {
            class Scanner <<Subsystem>>
            class CodeGenerator <<Subsystem>>
            
            class Token
            class Num
            class Word
            class Real
            class Type
            class Array
        
            together {    
                class Tag        
                enum Kind
            }
        }
        
        class Parser <<Subsystem>>
        class Env
        
    }
    
    together {
        class ProgNodeBuilder <<Subsystem>>
        
        abstract class ProgNode
        abstract class ExprNode

   
        class IdNode
        class TempNode
        class ConstNode
        
        class OpNode
        class ArithNode
        class UnaryNode
        class AccessNode
        
        class LogicalNode
        class AndNode
        class OrNode
        class NotNode
        class RelNode
        
    
        together {
            class StmtNode
            class IfNode
            class ElseNode
            class SeqNode
            class WhileNode
            class DoNode 
            class SetNode
            class SetElemNode
            class BreakNode
        }
        
    }
}

ProgNode <|-- ExprNode
ProgNode <|--------- StmtNode

ExprNode <|-- ConstNode
ExprNode <|-- IdNode
ExprNode <|------ OpNode
ExprNode <|---- LogicalNode
ExprNode <|-- TempNode

OpNode <|-- ArithNode
OpNode <|-- UnaryNode
OpNode <|-- AccessNode

LogicalNode <|-- AndNode
LogicalNode <|-- OrNode
LogicalNode <|-- NotNode
LogicalNode <|-- RelNode

StmtNode <|--- IfNode
StmtNode <|--- ElseNode
StmtNode <|--- SetNode
StmtNode <|-- SeqNode
StmtNode <|--- WhileNode
StmtNode <|-- DoNode
StmtNode <|-- SetElemNode
StmtNode <|--- BreakNode

Token <|-- Num
Token <|-- Real
Token <|-- Word
Word <|-- Type
Type <|-- Array

Scanner --> Token

Token -> Tag
Tag o- Kind

Parser -> Scanner
Parser ------> ProgNodeBuilder
Parser -> Tag

Compiler --> Scanner
Compiler --> Parser
Compiler --> CodeGenerator

ProgNodeBuilder *--> ProgNode

Parser .> Env


Compiler : +Compiler()
Compiler : +compile(Stream, ByteCodeStream) : void

CodeGenerator : #output : ByteCodeStream
CodeGenerator : #CodeGenerator(ByteCodeStream)
CodeGenerator : +visit(StmtNode) : void
CodeGenerator : +visit(ExprNode) : void

Scanner : -full : Boolean
Scanner : -buffer : Token
Scanner : -index : int
Scanner : -line : int
Scanner : -column : int
Scanner : -stream : iostream
Scanner : -tokenstream : TokenStream
Scanner : + Scanner(iostream)
Scanner : +scan() : Token&
Scanner : +reserve(Word) : void
Scanner : +putback() : void

Token : -tag : Tag
Token : -line : int
Token : -index : int
Token : +Token(Tag)
Token : +toString() : String

Num : -value : int
Num : +Num(int)
Num : +toString() : String

Real : -value : float
Real : +Real(float)
Real : +toString() : String

Word : -value : String
Word : +{field} and : Word = Word("&&", Tag.AND)
Word : +{field} or : Word = Word("||", Tag.OR)
Word : +{field} eq : Word = Word("==", Tag.EQ)
Word : +{field} ne : Word = Word("!=", Tag.NE)
Word : +{field} le : Word = Word("<=", Tag.LE)
Word : +{field} ge : Word = Word(">=", Tag.GE)
Word : +{field} minus : Word = Word("minus", Tag.MINUS)
Word : +{field} True : Word = Word("true", Tag.TRUE)
Word : +{field} FALSE : Word = Word("false", Tag.FALSE)
Word : +{field} temp : Word = Word("t", Tag.TEMP)
Word : +Word(String, int)
Word : +toString() : String

Type : -width : int    
Type : +{field} Int : Type("int", Tag.BASIC, 4) 
Type : +{field} Float : Type("float", Tag.BASIC, 8) 
Type : +{field} Char : Type("char", Tag.BASIC, 1) 
Type : +{field} Bool : Type("bool", Tag.BASIC, 1) 
Type : +Type(String, Kind, int)
Type : +{static} numeric(Type) : bool
Type : +{static} max(Type, Type) : Type

Array : -of : Type
Array : -size : int
Array : +Array(int, Type)
Array : +toString() : String

Tag : +kind : Kind
Tag : +toString() : String

Kind : +AND : int = 256
Kind : +BASIC : int = 257
Kind : +BREAK : int = 258
Kind : +DO : int = 259
Kind : +ELSE : int = 260
Kind : +EQ : int = 261
Kind : +FALSE : int = 262
Kind : +GE : int = 263
Kind : +ID : int = 264
Kind : +IF : int = 265
Kind : +INDEX : int = 266
Kind : +LE : int = 267
Kind : +MINUS : int = 268
Kind : +NE : int = 269
Kind : +NUM : int = 270
Kind : +OR : int = 271
Kind : +REAL : int = 272 
Kind : +TEMP : int = 273
Kind : +TRUE : int = 274
Kind : +WHILE : int = 275

Parser : -look : Token
Parser : -top : Env
Parser : -used : int
Parser : -scanner : Scanner
Parser : -builder : ProgNodeBuilder
Parser : +parse(Scanner&, ProgNodeBuilder&)
Parser : -move() : void
Parser : -error(String) : void
Parser : -match(int) : void
Parser : +program() : void
