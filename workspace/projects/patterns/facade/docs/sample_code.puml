UnaryNode : -expr : ExprNode
UnaryNode : +UnaryNode(Token, ExprNode)
UnaryNode : +toString() : String

AccessNode : -var : IdNode
AccessNode : -index : ExprNode
AccessNode : +AccessNode(Id, ExprNode, Type)
