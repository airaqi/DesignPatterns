ProgNodeBuilder : +createReturnStatement(ProgNode) : ProgNode
ProgNodeBuilder : +createCondition(cond: ProgNode, true : ProgNode, false : ProgNode) : ProgNode
ProgNodeBuilder : +getRootNode() : ProgNode

ProgNode : -index : int
ProgNode : -line : int
ProgNode : -column : int
ProgNode : #ProgNode()
